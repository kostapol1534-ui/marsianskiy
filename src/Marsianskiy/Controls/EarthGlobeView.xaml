<UserControl x:Class="Marsianskiy.Controls.EarthGlobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Marsianskiy.Controls"
             IsHitTestVisible="True">
  <Grid>
    <local:GlobeVisualHost x:Name="Host" />
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#E61B2130" BorderBrush="#526078" BorderThickness="1" CornerRadius="12" Padding="13,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding NodeName, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#F5F3FF" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Text="{Binding NodeDetails, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#9BA9BD" FontSize="10" Margin="0,2,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="#332A56" CornerRadius="6" Padding="8,4" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="TUN" Foreground="#C5B5FF" FontWeight="Bold" FontSize="10" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
