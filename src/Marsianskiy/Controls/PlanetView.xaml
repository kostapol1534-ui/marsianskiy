<UserControl x:Class="Marsianskiy.Controls.PlanetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
  <Viewbox Stretch="Uniform">
    <Grid Width="300" Height="300">
      <Ellipse Width="250" Height="250" Opacity="0.5">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#6D55D9" Offset="0" />
            <GradientStop Color="#002D244D" Offset="0.72" />
            <GradientStop Color="#00090C12" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Grid x:Name="FloatLayer" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
        <Ellipse Width="146" Height="146" Margin="77,77,77,77">
          <Ellipse.Fill>
            <RadialGradientBrush GradientOrigin="0.3,0.25" Center="0.48,0.48" RadiusX="0.68" RadiusY="0.68">
              <GradientStop Color="#F4B77B" Offset="0" />
              <GradientStop Color="#C87CD9" Offset="0.34" />
              <GradientStop Color="#7354C7" Offset="0.7" />
              <GradientStop Color="#272340" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="48" Height="15" Margin="101,103,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#604990" Opacity="0.28" />
        <Ellipse Width="28" Height="10" Margin="157,142,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#352C63" Opacity="0.32" />
        <Ellipse Width="36" Height="12" Margin="107,169,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#D49BD6" Opacity="0.18" />

        <Grid x:Name="OuterOrbit" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
          <Ellipse Width="272" Height="94" Stroke="#B49AFF" StrokeThickness="2" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform Angle="-24" /></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="13" Height="13" Margin="258,105,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#F1B46F">
            <Ellipse.Effect><DropShadowEffect Color="#F1B46F" BlurRadius="16" ShadowDepth="0" /></Ellipse.Effect>
          </Ellipse>
        </Grid>

        <Grid x:Name="InnerOrbit" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><RotateTransform Angle="90" /></Grid.RenderTransform>
          <Ellipse Width="224" Height="74" Stroke="#8CCEE8" StrokeThickness="1.3" Opacity="0.36" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform Angle="37" /></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="9" Height="9" Margin="73,78,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#9AE1F1">
            <Ellipse.Effect><DropShadowEffect Color="#9AE1F1" BlurRadius="12" ShadowDepth="0" /></Ellipse.Effect>
          </Ellipse>
        </Grid>
      </Grid>
    </Grid>
  </Viewbox>
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="OuterOrbit" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:16" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="InnerOrbit" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="90" To="-270" Duration="0:0:11" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="FloatLayer" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-5" To="5" Duration="0:0:3.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </UserControl.Triggers>
</UserControl>
